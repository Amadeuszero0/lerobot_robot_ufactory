<?xml version="1.0" encoding="utf-8"?>
<!--
  Kinematic-only PiPER-X model.

  Joint origins, fixed rotations, axes, and limits are copied from AgileX's
  official agx_arm_urdf/piper_x/urdf/piper_x_description.urdf.  Visual,
  collision, and inertial elements are intentionally omitted because the
  LeRobot controller only parses the serial kinematic chain.

  Source: https://github.com/agilexrobotics/agx_arm_urdf
-->
<robot name="piper_x">
  <link name="base_link"/>
  <link name="link1"/>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 3.1415926"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

  <link name="link2"/>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963 -3.005806 -3.1415926"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
  </joint>

  <link name="link3"/>
  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 2.8380798"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
  </joint>

  <link name="link4"/>
  <joint name="joint4" type="revolute">
    <origin xyz="0.27364 0 0" rpy="0 0 0.0806342"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.553343" upper="1.553343" effort="100" velocity="5"/>
  </joint>

  <link name="link5"/>
  <joint name="joint5" type="revolute">
    <origin xyz="0.07466 0 0" rpy="-1.5707963 1.5707963 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.553343" upper="1.553343" effort="100" velocity="5"/>
  </joint>

  <link name="link6"/>
  <joint name="joint6" type="revolute">
    <origin xyz="0 -0.035 0" rpy="1.5707963 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
  </joint>
</robot>
